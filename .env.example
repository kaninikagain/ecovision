# Copy to .env (never commit .env). Get a key at https://aistudio.google.com
GEMINI_API_KEY=
MODEL_NAME=gemma-4-31b-it
PROVIDER=gemini
# Local open-weights mode (needs Ollama running and the model pulled; check the exact tag in the Ollama library):
# PROVIDER=ollama
# MODEL_NAME=<your-local-gemma-4-tag>
LOG_SCANS=0
MAX_IMAGE_MB=5
RATE_PER_MIN=20
