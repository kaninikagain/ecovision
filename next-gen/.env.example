# EcoVision Mini AI - Environment Configuration
# Copy this file to .env.local for local development.

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=

# Model identifier (e.g. gemma-4-31b-it, gemini-1.5-flash, gemini-2.5-flash)
MODEL_NAME=gemma-4-31b-it

# Provider: "gemini" (cloud) or "ollama" (local open weights)
PROVIDER=gemini

# Ollama local instance URL (only if PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

# Upload and Security Controls
MAX_IMAGE_MB=5
RATE_PER_MIN=20
LOG_SCANS=0
